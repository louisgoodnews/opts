# Umbelegbare eingebaute Tastenaktionen und das Zurücksetzen der Belegung (M-0142).

set-bk-parking_brake = Feststellbremse
set-bk-parking_brake-desc = Zieht die Feststellbremse an oder löst sie.
set-bk-minimap_toggle = Minimap an oder aus
set-bk-minimap_toggle-desc = Blendet die Minimap ein oder aus.
set-bk-minimap_rotate = Minimap: Norden oben oder Fahrtrichtung oben
set-bk-minimap_rotate-desc = Schaltet die Minimap zwischen Norden oben und Fahrtrichtung oben um.
set-bk-minimap_speed_zoom = Minimap: Zoom nach Geschwindigkeit
set-bk-minimap_speed_zoom-desc = Schaltet den Zoom nach Geschwindigkeit ein oder aus.
set-bk-minimap_zoom_in = Minimap: hineinzoomen
set-bk-minimap_zoom_in-desc = Ein Zoomschritt näher (Ziffernblock + zoomt immer hinein).
set-bk-minimap_zoom_out = Minimap: herauszoomen
set-bk-minimap_zoom_out-desc = Ein Zoomschritt weiter weg (Ziffernblock - zoomt immer heraus).
set-bk-full_map = Große Karte
set-bk-full_map-desc = Öffnet und schließt die große Karte.
set-bk-door_camera = Türkamera: nächste Tür
set-bk-door_camera-desc = Schaltet die Türkamera durch die Türen.
set-bk-help = Hilfe
set-bk-help-desc = Öffnet die Hilfe.
set-bk-theme = Helles und dunkles Thema wechseln
set-bk-theme-desc = Wechselt zwischen dem dunklen und dem hellen Thema.
set-bk-quick_save = Schnellspeichern
set-bk-quick_save-desc = Speichert den Schnellspeicherplatz.
set-bk-quick_load = Schnellladen
set-bk-quick_load-desc = Lädt den Schnellspeicherplatz.
set-bk-switch_vehicle = Nächstes Fahrzeug
set-bk-switch_vehicle-desc = Wechselt zum nächsten Fahrzeug der Sitzung.
set-bk-switch_vehicle_prev = Vorheriges Fahrzeug
set-bk-switch_vehicle_prev-desc = Wechselt zum vorherigen Fahrzeug der Sitzung.
set-bk-developer_panel = Entwicklerfeld
set-bk-developer_panel-desc = Blendet das Entwicklerfeld ein oder aus.
set-reset-keys-all = Zurücksetzen: Alle Tastenbelegungen
set-reset-keys-all-desc = Setzt Alle Tastenbelegungen auf die Standardwerte zurück.
set-reset-keys-vehicle = Zurücksetzen: Fahrzeugtasten
set-reset-keys-vehicle-desc = Setzt Fahrzeugtasten auf die Standardwerte zurück.
set-reset-keys-rail = Zurücksetzen: Tasten für Tram und Bahn
set-reset-keys-rail-desc = Setzt die Tasten für Tram und Bahn auf die Standardwerte zurück.
set-reset-keys-drive = Zurücksetzen: Fahrtasten
set-reset-keys-drive-desc = Setzt Fahrtasten auf die Standardwerte zurück.
set-reset-keys-camera = Zurücksetzen: Kameratasten
set-reset-keys-camera-desc = Setzt Kameratasten auf die Standardwerte zurück.
set-reset-keys-map = Zurücksetzen: Kartentasten
set-reset-keys-map-desc = Setzt Kartentasten auf die Standardwerte zurück.
set-reset-keys-ui = Zurücksetzen: Bedientasten
set-reset-keys-ui-desc = Setzt Bedientasten auf die Standardwerte zurück.
settings-toast-keys-reset = Tastenbelegung zurückgesetzt: { $count } geändert
settings-toast-keys-reset-none = Die Tastenbelegung hat schon die Standardwerte.
set-mouse-driving = Mit der Maus fahren
set-mouse-driving-desc = Ein Druck auf das Mausrad schaltet das Fahren mit der Maus ein und aus: Die Höhe des Zeigers ist Gas (obere Hälfte) und Bremse (untere Hälfte), seine Breite die Lenkung. Ein Rechtsklick gibt die Maus bis zum nächsten Rechtsklick frei. Gilt sofort.
set-bk-rail_forward = Schiene: vorwärts
set-bk-rail_forward-desc = Schienenfahrzeuge: vorwärts fahren (Richtungsschalter des Führerstands; der Rückfahrschalter einer Bahn aus).
set-bk-rail_reverse = Schiene: rückwärts
set-bk-rail_reverse-desc = Schienenfahrzeuge: rückwärts fahren (nur im Stand).
set-bk-rail_lever_up = Schiene: Fahrhebel hoch
set-bk-rail_lever_up-desc = Schienenfahrzeuge: bewegt den Fahrhebel zur Traktion, solange die Taste gehalten wird; er bleibt stehen, wo man ihn loslässt.
set-bk-rail_lever_down = Schiene: Fahrhebel runter
set-bk-rail_lever_down-desc = Schienenfahrzeuge: bewegt den Fahrhebel zum Bremsen, solange die Taste gehalten wird; er bleibt stehen, wo man ihn loslässt. Auf der deutschen Tastatur Y.
set-bk-rail_branch_left = Schiene: Weiche links
set-bk-rail_branch_left-desc = Schienenfahrzeuge: nimmt an der nächsten Weiche den linken Zweig.
set-bk-rail_branch_straight = Schiene: Weiche geradeaus
set-bk-rail_branch_straight-desc = Schienenfahrzeuge: bleibt an der nächsten Weiche auf dem geraden Gleis.
set-bk-rail_branch_right = Schiene: Weiche rechts
set-bk-rail_branch_right-desc = Schienenfahrzeuge: nimmt an der nächsten Weiche den rechten Zweig.
set-bk-rail_lever_zero = Schiene: Hebel auf Null
set-bk-rail_lever_zero-desc = Schienenfahrzeuge: stellt den Fahrhebel sofort auf Null.
set-bk-rail_switch_toggle = Schiene: Weiche umstellen
set-bk-rail_switch_toggle-desc = Schienenfahrzeuge: stellt die Weiche voraus auf den nächsten Weg (gerade, links, rechts); nur wenn eine Weiche in 150 m Entfernung liegt.
set-bk-rail_switch_cab = Schiene: Führerstand wechseln
set-bk-rail_switch_cab-desc = Schienenfahrzeuge mit einem Führerstand an jedem Ende (die Köpfe A und B einer Bahn) oder mit mehreren Zügen in Traktion: gibt Steuerung und Führerstandsansicht an den nächsten Führerstand weiter.
