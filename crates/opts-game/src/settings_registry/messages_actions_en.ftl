# Rebindable built-in key actions and the reset of bindings (M-0142).

set-bk-parking_brake = Parking brake
set-bk-parking_brake-desc = Applies or releases the parking brake.
set-bk-minimap_toggle = Mini map on or off
set-bk-minimap_toggle-desc = Shows or hides the mini map.
set-bk-minimap_rotate = Mini map: north up or heading up
set-bk-minimap_rotate-desc = Switches the mini map between north up and heading up.
set-bk-minimap_speed_zoom = Mini map: speed zoom
set-bk-minimap_speed_zoom-desc = Switches the zoom that follows the speed on or off.
set-bk-minimap_zoom_in = Mini map: zoom in
set-bk-minimap_zoom_in-desc = One zoom step closer (the numpad + always zooms in).
set-bk-minimap_zoom_out = Mini map: zoom out
set-bk-minimap_zoom_out-desc = One zoom step further away (the numpad - always zooms out).
set-bk-full_map = Full-size map
set-bk-full_map-desc = Opens and closes the full-size map.
set-bk-door_camera = Door camera: next door
set-bk-door_camera-desc = Cycles the door camera through the doors.
set-bk-help = Help
set-bk-help-desc = Opens the help.
set-bk-theme = Switch light and dark theme
set-bk-theme-desc = Switches between the dark and the light theme.
set-bk-quick_save = Quick save
set-bk-quick_save-desc = Saves the quick slot.
set-bk-quick_load = Quick load
set-bk-quick_load-desc = Loads the quick slot.
set-bk-switch_vehicle = Next vehicle
set-bk-switch_vehicle-desc = Switches to the next vehicle of the session.
set-bk-switch_vehicle_prev = Previous vehicle
set-bk-switch_vehicle_prev-desc = Switches to the previous vehicle of the session.
set-bk-developer_panel = Developer panel
set-bk-developer_panel-desc = Shows or hides the developer panel.
set-reset-keys-all = Reset: all key bindings
set-reset-keys-all-desc = Puts all key bindings back to their defaults.
set-reset-keys-vehicle = Reset: vehicle keys
set-reset-keys-vehicle-desc = Puts vehicle keys back to their defaults.
set-reset-keys-drive = Reset: driving keys
set-reset-keys-drive-desc = Puts driving keys back to their defaults.
set-reset-keys-camera = Reset: camera keys
set-reset-keys-camera-desc = Puts camera keys back to their defaults.
set-reset-keys-map = Reset: map keys
set-reset-keys-map-desc = Puts map keys back to their defaults.
set-reset-keys-ui = Reset: interface keys
set-reset-keys-ui-desc = Puts interface keys back to their defaults.
settings-toast-keys-reset = Key bindings reset: { $count } changed
settings-toast-keys-reset-none = The key bindings already have their defaults.
