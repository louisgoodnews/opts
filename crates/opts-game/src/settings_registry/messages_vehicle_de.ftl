# Kategorie Fahrzeug: wie ein Fahrzeug bei Fahrtbeginn vorbereitet ist (M-0141).

set-vehicle-setup = Fahrzeugvorbereitung
set-vehicle-setup-desc = Wie weit das Fahrzeug bei Fahrtbeginn vorbereitet ist: 0 nichts gestartet, 0,25 Bordnetz ein, 0,5 Zündung in Fahrstellung, 0,75 Motor läuft, 1 fahrbereit (Feststellbremse gelöst). Gilt für das nächste Fahrzeug; ein höherer Wert führt auch ein Fahrzeug weiter, das noch nicht so weit ist.
set-vehicle-fuel = Kraftstoff
set-vehicle-fuel-desc = Kraftstoff im Tank zu Beginn als Anteil des Tanks (0 leer, 1 voll). Gilt für das nächste Fahrzeug.
set-vehicle-lights = Licht zu Beginn
set-vehicle-lights-desc = Das Licht, das eingeschaltet wird, sobald das Bordnetz an ist. Gilt für das nächste Fahrzeug.
set-opt-start-lights-off = Aus
set-opt-start-lights-parking = Standlicht
set-opt-start-lights-dipped = Abblendlicht
