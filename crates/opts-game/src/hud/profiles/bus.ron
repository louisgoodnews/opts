// HUD profile of a single-body bus (docs/src/architecture/hud-registry.md).
HudProfile(
    kind: Bus,
    widgets: [
        (id: "session", order: 10),
        (id: "clock", order: 20),
        (id: "camera-label", order: 10),
        (id: "alerts", order: 10),
        (id: "speed", order: 10),
        (id: "gear", order: 20),
        (id: "rpm", order: 30),
        (id: "parking-brake", order: 40),
        (id: "controls-hint", order: 10),
    ],
)
