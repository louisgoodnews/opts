// HUD profile of a tram: no engine speed, the direction and the power lever instead of the brake lamp and the gear (docs/src/architecture/hud-registry.md).
// Slots: bottom-left cluster (rows hints, alerts, instruments in a fixed order), mini map bottom right.
HudProfile(
    kind: Tram,
    widgets: [
        (id: "session", order: 10),
        (id: "clock", order: 20),
        (id: "camera-label", order: 10),
        (id: "controls-hint", order: 10),
        (id: "alerts", order: 20),
        (id: "speed", order: 30),
        (id: "rail-direction", order: 40),
        (id: "rail-lever", order: 50),
        (id: "minimap", order: 10),
    ],
)
