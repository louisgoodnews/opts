// HUD profile of a tram: no engine speed, the brake lamp before the gear.
HudProfile(
    kind: Tram,
    widgets: [
        (id: "session", order: 10),
        (id: "clock", order: 20),
        (id: "camera-label", order: 10),
        (id: "alerts", order: 10),
        (id: "speed", order: 10),
        (id: "parking-brake", order: 20),
        (id: "gear", order: 30),
        (id: "controls-hint", order: 10),
    ],
)
